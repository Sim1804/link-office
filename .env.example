# ─────────────────────────────────────────────────────────
# Link-Office — Variables d'environnement requises
# Copier ce fichier en .env.local et remplir toutes les valeurs
# NE JAMAIS commiter .env.local dans le dépôt Git
# ─────────────────────────────────────────────────────────

# NextAuth.js
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-secure-random-secret-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# Base de données PostgreSQL (Neon ou autre)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/linkoffice

# Groq (LLM pour IRIS)
# Obtenir sur : https://console.groq.com/keys
GROQ_API_KEY=

# Optionnel — URL publique de l'API (laisser vide pour utiliser l'API interne Next.js)
# NEXT_PUBLIC_API_URL=
