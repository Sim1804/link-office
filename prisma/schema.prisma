generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                   @id @default(cuid())
  email          String                   @unique
  firstName      String
  lastName       String
  password       String?
  points         Int                      @default(0)
  role           UserRole                 @default(EMPLOYEE)
  organizationId String?
  createdAt      DateTime                 @default(now())
  assessments    Assessment[]
  pairsInitiated RelationalPair[]         @relation("PairInitiator")
  pairsReceived  RelationalPair[]         @relation("PairReceiver")
  prescriptions  RelationalPrescription[]
  organization   Organization?            @relation(fields: [organizationId], references: [id])
  badges         UserBadge[]
}

model Assessment {
  id                   String                @id @default(cuid())
  userId               String
  campaignId           String?
  status               AssessmentStatus      @default(DRAFT)
  consentInformation   Boolean               @default(false)
  consentResearch      Boolean               @default(false)
  consentParticipation Boolean               @default(false)
  startedAt            DateTime              @default(now())
  submittedAt          DateTime?
  updatedAt            DateTime              @updatedAt
  adaptiveAnswers      AdaptiveAnswer[]
  campaign             Campaign?             @relation(fields: [campaignId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  demographic          DemographicProfile?
  result               IqrhResult?
  answers              QuestionnaireAnswer[]

  @@index([userId, status])
}

model DemographicProfile {
  id                   String     @id @default(cuid())
  assessmentId         String     @unique
  gender               String
  ageRange             String
  country              String
  department           String?
  occupation           String
  organizationSize     String?
  relationshipStatus   String
  children             Boolean
  childrenCount        Int?
  livingSituation      String
  livingSituationOther String?
  selectedSituations   String[]
  primarySituation     String?
  assessment           Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AdaptiveModule {
  id               String             @id
  triggerSituation String             @unique
  title            String
  objective        String
  position         Int
  questions        AdaptiveQuestion[]
}

model Question {
  id        String                @id
  kind      QuestionKind          @default(REFERENCE)
  dimension Dimension
  text      String
  position  Int                   @unique
  required  Boolean               @default(true)
  answers   QuestionnaireAnswer[]
}

model AdaptiveQuestion {
  id       String           @id
  moduleId String
  text     String
  position Int
  required Boolean          @default(true)
  polarity AdaptivePolarity @default(POSITIVE)
  answers  AdaptiveAnswer[]
  module   AdaptiveModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
}

model QuestionnaireAnswer {
  id           String     @id @default(cuid())
  assessmentId String
  questionId   String
  value        Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
}

model AdaptiveAnswer {
  id                 String           @id @default(cuid())
  assessmentId       String
  adaptiveQuestionId String
  value              Int
  question           AdaptiveQuestion @relation(fields: [adaptiveQuestionId], references: [id])
  assessment         Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, adaptiveQuestionId])
}

model IqrhResult {
  id                    String                  @id @default(cuid())
  assessmentId          String                  @unique
  globalScore           Float
  socialScore           Float
  affectiveScore        Float
  sentimentalScore      Float
  professionalScore     Float
  selfScore             Float
  weather               String
  balanceIndex          Float
  priorityDimension     Dimension
  strengths             String[]
  watchpoints           String[]
  primaryProfile        String
  secondaryProfile      String
  profileSummary        String
  createdAt             DateTime                @default(now())
  bestDimension         Dimension               @default(SOCIAL)
  secondBestDimension   Dimension               @default(SOCIAL)
  thirdBestDimension    Dimension               @default(SOCIAL)
  weakDimension         Dimension               @default(SOCIAL)
  weatherText           String                  @default("")
  weatherTitle          String                  @default("")
  balanceInterpretation String                  @default("")
  balanceLevel          String                  @default("")
  weatherIcon           String                  @default("")
  icr                   IcrResult?
  assessment            Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  profile               ProfileResult?
  prescription          RelationalPrescription?
}

model IcrResult {
  id                     String     @id @default(cuid())
  iqrhResultId           String     @unique
  score                  Int
  familyComplexity       Int
  professionalComplexity Int
  lifeTransitions        Int
  relationalLoad         Int
  protectiveResources    Int
  level                  String
  interpretation         String
  riskFactors            String[]
  protectiveFactors      String[]
  resources              String[]
  vulnerabilities        String[]
  barriers               String[]
  levers                 String[]
  dominantNeeds          String[]
  iqrhResult             IqrhResult @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
}

model ProfileResult {
  id                  String     @id @default(cuid())
  iqrhResultId        String     @unique
  primaryName         String
  secondaryName       String
  primaryScore        Int
  secondaryScore      Int
  primaryConfidence   Int
  secondaryConfidence Int
  signature           String
  scores              Json
  irisContext         Json
  iqrhResult          IqrhResult @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
}

/// Source catalogue imported verbatim from Bibliotheques_LINK_OFFICE_V1.xlsm.
/// `data` deliberately preserves every original spreadsheet column and its text.
model LibraryItem {
  id                String             @id
  library           String
  title             String
  category          String?
  data              Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  prescriptionItems PrescriptionItem[]

  @@index([library])
  @@index([library, category])
}

model RelationalPrescription {
  id                String             @id @default(cuid())
  userId            String
  iqrhResultId      String             @unique
  title             String
  summary           String
  priorityDimension Dimension
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             PrescriptionItem[]
  iqrhResult        IqrhResult         @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  libraryItemId  String
  kind           String
  position       Int
  rationale      String
  status         String                 @default("PROPOSED")
  createdAt      DateTime               @default(now())
  libraryItem    LibraryItem            @relation(fields: [libraryItemId], references: [id])
  prescription   RelationalPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, libraryItemId])
  @@unique([prescriptionId, position])
}

model Badge {
  id             String      @id @default(cuid())
  name           String      @unique
  description    String
  icon           String
  pointsRequired Int
  createdAt      DateTime    @default(now())
  users          UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model RelationalPair {
  id          String     @id @default(cuid())
  initiatorId String
  receiverId  String
  status      PairStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  initiator   User       @relation("PairInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User       @relation("PairReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
}

model Organization {
  id           String                @id @default(cuid())
  name         String
  type         OrganizationType
  siren        String?
  domainName   String?
  codeAccess   String                @unique
  logoUrl      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  campaigns    Campaign[]
  services     OrganizationService[]
  subscription Subscription?
  users        User[]
}

model OrganizationService {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String
  targetNeed     String
  linkUrl        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  startDate      DateTime
  endDate        DateTime
  status         CampaignStatus @default(ACTIVE)
  assessments    Assessment[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  stripeCustomerId String?      @unique
  stripePriceId    String?
  status           String       @default("INCOMPLETE")
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
}

enum QuestionKind {
  REFERENCE
  ADAPTIVE
}

enum Dimension {
  SOCIAL
  AFFECTIVE
  SENTIMENTAL
  PROFESSIONAL
  SELF
}

enum AdaptivePolarity {
  POSITIVE
  NEGATIVE
}

enum PairStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrganizationType {
  B2B
  B2B2C
  COLLECTIVITE
}

enum UserRole {
  EMPLOYEE
  CITIZEN
  MEMBER
  ADMIN_B2B
  ADMIN_B2B2C
  ADMIN_COLLECTIVITE
  SUPER_ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}
