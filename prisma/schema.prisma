generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  firstName          String
  lastName           String
  createdAt          DateTime                 @default(now())
  organizationId     String?
  campaignId         String?
  password           String?
  points             Int                      @default(0)
  role               UserRole                 @default(EMPLOYEE)
  newsletterOptIn    Boolean                  @default(false)
  subscription       SubscriptionTier         @default(FREEMIUM)
  matchingOptIn      Boolean                  @default(false)
  mustChangePassword Boolean                  @default(false)
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean                  @default(false)
  emailVerified      DateTime?
  irisUsageCount     Int                      @default(0)
  lastIrisUsage      DateTime?
  assessments        Assessment[]
  binomesAsUserA     Binome[]                 @relation("BinomeUserA")
  binomesAsUserB     Binome[]                 @relation("BinomeUserB")
  binomeSuggestionsA BinomeSuggestion[]       @relation("BinomeSuggestionUserA")
  binomeSuggestionsB BinomeSuggestion[]       @relation("BinomeSuggestionUserB")
  binomePreference   BinomePreference?
  binomeCheckins     BinomeCheckin[]
  binomeFeedbacks    BinomeFeedback[]
  prescriptions      RelationalPrescription[]
  organization       Organization?            @relation(fields: [organizationId], references: [id])
  campaign           Campaign?                @relation(fields: [campaignId], references: [id])
  badges             UserBadge[]
  UserSubscription   UserSubscription?
  stats              UserStats?
  notifications      Notification[]
  meteoCheckins      MeteoCheckin[]
  lifeEvents         LifeEvent[]
  relationalPlans    RelationalPlan[]
  userMicroDefis     UserMicroDefi[]
  resourceRelations  ResourceRelation[]
  journalEntries     JournalEntry[]
  savedResources     SavedResource[]

  @@index([organizationId])
  @@index([campaignId])
  @@index([role])
}

model Assessment {
  id                          String                   @id @default(cuid())
  userId                      String
  status                      AssessmentStatus         @default(DRAFT)
  consentInformation          Boolean                  @default(false)
  consentResearch             Boolean                  @default(false)
  consentParticipation        Boolean                  @default(false)
  startedAt                   DateTime                 @default(now())
  submittedAt                 DateTime?
  updatedAt                   DateTime                 @updatedAt
  campaignId                  String?
  /// Snapshot du questionnaireConfig au moment de la passation (versionnage)
  questionnaireConfigSnapshot Json?
  adaptiveAnswers             AdaptiveAnswer[]
  campaign                    Campaign?                @relation(fields: [campaignId], references: [id])
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  CampaignVariableAnswer      CampaignVariableAnswer[]
  demographic                 DemographicProfile?
  result                      IqrhResult?
  answers                     QuestionnaireAnswer[]

  @@index([userId, status])
  @@index([campaignId, status])
}

model DemographicProfile {
  id                   String     @id @default(cuid())
  assessmentId         String     @unique
  gender               String
  ageRange             String
  country              String
  department           String?
  occupation           String
  organizationSize     String?
  relationshipStatus   String
  children             Boolean
  childrenCount        Int?
  livingSituation      String
  livingSituationOther String?
  selectedSituations   String[]
  primarySituation     String?
  assessment           Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AdaptiveModule {
  id               String             @id
  triggerSituation String             @unique
  title            String
  objective        String
  position         Int
  isActive         Boolean            @default(true)
  version          Int                @default(1)
  questions        AdaptiveQuestion[]
}

model Question {
  id        String                @id
  kind      QuestionKind          @default(REFERENCE)
  dimension Dimension
  text      String
  position  Int
  required  Boolean               @default(true)
  isActive  Boolean               @default(true)
  version   Int                   @default(1)
  answers   QuestionnaireAnswer[]

  @@unique([position, version])
}

model AdaptiveQuestion {
  id       String           @id
  moduleId String
  text     String
  position Int
  required Boolean          @default(true)
  polarity AdaptivePolarity @default(POSITIVE)
  isActive Boolean          @default(true)
  version  Int              @default(1)
  answers  AdaptiveAnswer[]
  module   AdaptiveModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position, version])
}

model QuestionnaireAnswer {
  id           String     @id @default(cuid())
  assessmentId String
  questionId   String
  value        Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
}

model AdaptiveAnswer {
  id                 String           @id @default(cuid())
  assessmentId       String
  adaptiveQuestionId String
  value              Int
  question           AdaptiveQuestion @relation(fields: [adaptiveQuestionId], references: [id])
  assessment         Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, adaptiveQuestionId])
}

model IqrhResult {
  id                           String                  @id @default(cuid())
  assessmentId                 String                  @unique
  globalScore                  Float
  socialScore                  Float
  affectiveScore               Float
  sentimentalScore             Float
  professionalScore            Float
  selfScore                    Float
  weather                      String
  balanceIndex                 Float
  priorityDimension            Dimension
  strengths                    String[]
  watchpoints                  String[]
  primaryProfile               String
  secondaryProfile             String
  profileSummary               String
  createdAt                    DateTime                @default(now())
  bestDimension                Dimension               @default(SOCIAL)
  secondBestDimension          Dimension               @default(SOCIAL)
  thirdBestDimension           Dimension               @default(SOCIAL)
  weakDimension                Dimension               @default(SOCIAL)
  weatherText                  String                  @default("")
  weatherTitle                 String                  @default("")
  balanceInterpretation        String                  @default("")
  balanceLevel                 String                  @default("")
  weatherIcon                  String                  @default("")
  weatherTextPremium           String                  @default("")
  weatherTitleFull             String                  @default("")
  dimensionDetails             Json                    @default("[]")
  balanceInterpretationPremium String                  @default("")
  radarSummary                 String                  @default("")
  strengthDetails              Json                    @default("[]")
  watchpointDetails            Json                    @default("[]")
  globalScoreText              String                  @default("")
  globalScoreTextPremium       String                  @default("")
  icr                          IcrResult?
  assessment                   Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  profile                      ProfileResult?
  prescription                 RelationalPrescription?
}

model IcrResult {
  id                     String     @id @default(cuid())
  iqrhResultId           String     @unique
  score                  Int
  familyComplexity       Int
  professionalComplexity Int
  lifeTransitions        Int
  relationalLoad         Int
  protectiveResources    Int
  level                  String
  interpretation         String
  riskFactors            String[]
  protectiveFactors      String[]
  resources              String[]
  vulnerabilities        String[]
  barriers               String[]
  levers                 String[]
  dominantNeeds          String[]
  interpretationPremium  String     @default("")
  vulnerabilityDetails   Json       @default("[]")
  dominantNeedDetails    Json       @default("[]")
  moduleDetails          Json       @default("[]")
  iqrhResult             IqrhResult @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
}

model ProfileResult {
  id                  String     @id @default(cuid())
  iqrhResultId        String     @unique
  primaryName         String
  secondaryName       String
  primaryScore        Int
  secondaryScore      Int
  primaryConfidence   Int
  secondaryConfidence Int
  signature           String
  scores              Json
  irisContext         Json
  iqrhResult          IqrhResult @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
}

/// Source catalogue imported verbatim from Bibliotheques_LINK_OFFICE_V1.xlsm.
/// `data` deliberately preserves every original spreadsheet column and its text.
model LibraryItem {
  id                String             @id
  library           String
  title             String
  category          String?
  data              Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  prescriptionItems PrescriptionItem[]

  @@index([library])
  @@index([library, category])
}

model RelationalPrescription {
  id                String             @id @default(cuid())
  userId            String
  iqrhResultId      String             @unique
  title             String
  summary           String
  priorityDimension Dimension
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             PrescriptionItem[]
  iqrhResult        IqrhResult         @relation(fields: [iqrhResultId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  libraryItemId  String
  kind           String
  position       Int
  rationale      String
  status         String                 @default("PROPOSED")
  createdAt      DateTime               @default(now())
  libraryItem    LibraryItem            @relation(fields: [libraryItemId], references: [id])
  prescription   RelationalPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, libraryItemId])
  @@unique([prescriptionId, position])
}

model Badge {
  id             String      @id @default(cuid())
  name           String      @unique
  description    String
  icon           String
  pointsRequired Int
  category       String?
  bonusPoints    Int?
  createdAt      DateTime    @default(now())
  users          UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  source     String?
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model UserStats {
  userId        String   @id
  totalPoints   Int      @default(0)
  weeklyPoints  Int      @default(0)
  monthlyPoints Int      @default(0)
  currentLevel  Int      @default(1)
  lastUpdated   DateTime @default(now()) @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String             @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  actionLink String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model EventLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  campaignId     String?
  eventType      String
  eventData      Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([eventType])
}

model BinomePreference {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  optIn                  Boolean   @default(false)
  availability           String[] // matin, midi, apres-midi, soiree, week-end, flexible
  communicationMode      String[] // messages, vocal
  preferredFrequency     String // legere, reguliere, soutenue
  agePreference          String // preference, indifferent
  genderPreference       String // preference, indifferent
  geographicalPreference String // souhaitee, indifferente
  expectations           String[]
  consentDate            DateTime?
  charterVersion         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BinomeSuggestion {
  id                   String    @id @default(cuid())
  userAId              String
  userBId              String
  campaignId           String?
  compatibilityScore   Float
  compatibilityReasons Json
  irisRecommendation   String
  suggestionDate       DateTime  @default(now())
  responseA            String? // ACCEPTED, REFUSED, PENDING
  responseB            String? // ACCEPTED, REFUSED, PENDING
  status               String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  userA                User      @relation("BinomeSuggestionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB                User      @relation("BinomeSuggestionUserB", fields: [userBId], references: [id], onDelete: Cascade)
  campaign             Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([userAId, userBId])
  @@index([status])
}

model Binome {
  id          String       @id @default(cuid())
  userAId     String
  userBId     String
  campaignId  String?
  startDate   DateTime     @default(now())
  endDate     DateTime?
  status      BinomeStatus @default(ACTIVE)
  healthScore Float        @default(100.0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userA        User                @relation("BinomeUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User                @relation("BinomeUserB", fields: [userBId], references: [id], onDelete: Cascade)
  campaign     Campaign?           @relation(fields: [campaignId], references: [id])
  checkins     BinomeCheckin[]
  feedbacks    BinomeFeedback[]
  gamification BinomeGamification?

  @@index([campaignId, status])
  @@index([userAId, userBId])
}

model BinomeCheckin {
  id            String   @id @default(cuid())
  binomeId      String
  userId        String
  date          DateTime @default(now())
  mood          Int? // 1 to 5
  actionStatus  String? // realissee, en_cours, pas_commencee, remplacee
  encouragement String?
  checkinType   String // RAPIDE, APPROFONDI
  binome        Binome   @relation(fields: [binomeId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BinomeFeedback {
  id                 String   @id @default(cuid())
  binomeId           String
  userId             String
  satisfaction       Int?
  usefulness         Int?
  reciprocity        Int?
  continuationIntent Boolean?
  issueReason        String?
  createdAt          DateTime @default(now())
  binome             Binome   @relation(fields: [binomeId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BinomeGamification {
  id           String @id @default(cuid())
  binomeId     String @unique
  userAId      String
  userBId      String
  pointsUserA  Int    @default(0)
  pointsUserB  Int    @default(0)
  pointsBinome Int    @default(0)
  badges       Json   @default("[]")
  unlockDates  Json   @default("{}")
  binome       Binome @relation(fields: [binomeId], references: [id], onDelete: Cascade)
}

model Organization {
  id         String           @id @default(cuid())
  name       String
  type       OrganizationType
  siren      String?
  domainName String?
  codeAccess String           @unique
  logoUrl    String?

  // Nouveaux champs B2B2C / B2B pour le contrat partenaire
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  contractType     String?
  startDate        DateTime?
  endDate          DateTime?
  targetPopulation Int?
  territory        String?
  quota            Int?

  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  ActionItem   ActionItem[]
  campaigns    Campaign[]
  services     OrganizationService[]
  subscription Subscription?
  users        User[]
}

model OrganizationService {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String
  targetNeed     String
  linkUrl        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                  String             @id @default(cuid())
  organizationId      String
  title               String
  description         String?
  startDate           DateTime
  endDate             DateTime
  status              CampaignStatus     @default(ACTIVE)
  offer               CampaignOffer      @default(PREMIUM)
  targetPopulation    Int?
  quota               Int?
  territory           String?
  codeAccess          String?            @unique
  logoUrl             String?
  questionnaireConfig Json               @default("{}")
  parentCampaignId    String?
  assessments         Assessment[]
  users               User[]
  invites             CampaignInvite[]
  binomes             Binome[]
  binomeSuggestions   BinomeSuggestion[]
  actions             ActionItem[]
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentCampaign      Campaign?          @relation("CampaignRenewal", fields: [parentCampaignId], references: [id])
  childCampaigns      Campaign[]         @relation("CampaignRenewal")
  CampaignVariable    CampaignVariable[]
  snapshot            CampaignSnapshot?

  @@index([organizationId, status])
}

model CampaignSnapshot {
  id         String   @id @default(cuid())
  campaignId String   @unique
  data       Json
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignInvite {
  id         String   @id @default(cuid())
  campaignId String
  email      String
  status     String   @default("INVITED") // INVITED | ACTIVATED | STARTED | COMPLETED
  invitedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  stripeCustomerId String?      @unique
  stripePriceId    String?
  status           String       @default("INCOMPLETE")
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  planType         String?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         ActionStatus @default(PROPOSEE)
  priority       String       @default("MEDIUM")
  pilot          String?
  dueDate        DateTime?
  dimension      Dimension?
  campaignId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([campaignId])
}

model CampaignVariable {
  id                     String                   @id
  campaignId             String
  question               String
  options                String[]
  required               Boolean                  @default(false)
  Campaign               Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  CampaignVariableAnswer CampaignVariableAnswer[]
}

model CampaignVariableAnswer {
  id               String           @id
  variableId       String
  assessmentId     String
  value            String
  Assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  CampaignVariable CampaignVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@unique([variableId, assessmentId])
}

model Lead {
  id             String   @id
  organization   String
  contactName    String
  email          String
  phone          String?
  planType       String
  companySize    String?
  populationSize String?
  beneficiaries  String?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
}

model UserSubscription {
  id                   String    @id
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("INCOMPLETE")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  User                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
}

enum QuestionKind {
  REFERENCE
  ADAPTIVE
}

enum Dimension {
  SOCIAL
  AFFECTIVE
  SENTIMENTAL
  PROFESSIONAL
  SELF
}

enum AdaptivePolarity {
  POSITIVE
  NEGATIVE
}

enum BinomeStatus {
  AWAITING_USER_B
  ACTIVE
  PAUSED
  REPORTED
  SUSPENDED
  WITHDRAWN
  COMPLETED
  CLOSED
}

enum OrganizationType {
  B2B
  B2B2C
  B2G
  COLLECTIVITE
}

enum UserRole {
  EMPLOYEE
  CITIZEN
  MEMBER
  ADMIN_B2B
  ADMIN_B2B2C
  ADMIN_B2G
  SUPER_ADMIN
}

enum CampaignStatus {
  DRAFT
  PLANIFIEE
  ACTIVE
  EN_CLOTURE
  CLOSED
  RENOUVELEE
}

enum ActionStatus {
  PROPOSEE
  VALIDEE
  PLANIFIEE
  EN_COURS
  REALISEE
  ABANDONNEE
}

enum CampaignOffer {
  PREMIUM
  PREMIUM_PLUS
}

enum SubscriptionTier {
  FREEMIUM
  PREMIUM
  PREMIUM_PLUS
}

model Recommendation {
  id                String   @id
  title             String
  category          String?
  dimensions        String[]
  profiles          String[]
  situations        String[]
  riskFactors       String[]
  protectiveFactors String[]
  needs             String[]
  priorityLevel     String?
  difficulty        String?
  estimatedTime     String?
  expectedImpact    Int?
  resultDelay       String?
  frequency         String?
  programmes        String[]
  partners          String[]
  displayText       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PartnerMatching {
  id          String   @id
  partnerName String
  category    String?
  publics     String[]
  territories String[]
  needs       String[]
  situations  String[]
  validation  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MicroDefi {
  id                 String   @id
  title              String
  description        String
  dimension          String?
  need               String?
  public             String?
  difficulty         String?
  estimatedTime      String?
  points             Int?
  expectedImpact     Int?
  compatibleBinome   Boolean  @default(false)
  compatibleIris     Boolean  @default(false)
  category           String?
  expectedValidation String?
  notificationText   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EcosystemActor {
  id               String   @id @default(cuid())
  segment          String
  name             String
  target           String
  territory        String
  linkScoreLevel   String
  description      String
  strategicReading String
  status           String   @default("TO_CONTACT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum NotificationType {
  QUESTIONNAIRE_REMINDER
  CHALLENGE_REMINDER
  BINOME_CHECKIN
  NEW_PRESCRIPTION
  IRIS_MESSAGE
  REPORT_AVAILABLE
  CAMPAIGN_LAUNCHED
  BADGE_UNLOCKED
}

enum NotificationStatus {
  UNREAD
  READ
  CLICKED
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================================================
// CARNET DE SANTE RELATIONNELLE
// =======================================================

model MeteoCheckin {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime @default(now())
  weather String // TRES_BIEN, PLUTOT_BIEN, MITIGE, FRAGILE, EN_DIFFICULTE
  factors String[] // famille, couple, amis, travail, solitude, etc.
  note    String?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model LifeEvent {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  category    String // couple, famille, travail, etudes, etc.
  impact      String // BEAUCOUP, UN_PEU, PAS_VRAIMENT, JE_NE_SAIS_PAS
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model RelationalPlan {
  id         String         @id @default(cuid())
  userId     String
  campaignId String?
  status     String         @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  priorities PlanPriority[]

  @@index([userId, status])
}

model PlanPriority {
  id        String         @id @default(cuid())
  planId    String
  dimension Dimension
  objective String
  rationale String
  status    String         @default("ACTIVE") // ACTIVE, COMPLETED, POSTPONED, DISMISSED
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  plan      RelationalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actions   PlanAction[]
}

model PlanAction {
  id             String       @id @default(cuid())
  priorityId     String
  title          String
  description    String?
  status         String       @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  dueDate        DateTime?
  completedAt    DateTime?
  feedbackRating String? // TRES_BIEN, PLUTOT_BIEN, NEUTRE, DIFFICILE, NON_REALISE
  feedbackImpact String? // BEAUCOUP, UN_PEU, PAS_VRAIMENT, PAS_DU_TOUT
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  priority       PlanPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
}

model UserMicroDefi {
  id          String    @id @default(cuid())
  userId      String
  defiId      String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  feedback    String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ResourceRelation {
  id          String   @id @default(cuid())
  userId      String
  name        String // Prénom ou libellé
  category    String // famille, ami, collegue, etc.
  frequency   String // quotidienne, hebdomadaire, etc.
  proximity   String // tres_proche, proche, etc.
  supportType String[] // emotionnel, pratique, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalEntry {
  id          String     @id @default(cuid())
  userId      String
  date        DateTime   @default(now())
  content     String
  dimension   Dimension?
  lifeEventId String?
  promptUsed  String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SavedResource {
  id           String   @id @default(cuid())
  userId       String
  resourceType String // LIBRARY_ITEM, PRESCRIPTION, EXTERNAL
  resourceId   String? // ID si interne
  title        String
  url          String?
  category     String?
  status       String   @default("SAVED") // SAVED, READ
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =======================================================
// MEDIA & PODCAST (CMS)
// =======================================================

enum MediaType {
  ARTICLE
  INTERVIEW
  DOSSIER
  TEMOIGNAGE
  PORTRAIT
  GUIDE
  ANALYSE
  PODCAST
  INFOGRAPHIE
  CHIFFRES_CLES
  VIDEO
  RESSOURCE
}

enum MediaCategoryType {
  SUJET
  PUBLIC
  MOMENT_DE_VIE
  DIMENSION_IQRH
  TYPE_CONTENU
}

enum EclaireurType {
  TEMOIN
  PROFESSIONNEL
}

model MediaCategory {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  type      MediaCategoryType
  createdAt DateTime          @default(now())
  contents  MediaContent[]    @relation("MediaToCategory")
}

model MediaEclaireur {
  id         String         @id @default(cuid())
  name       String
  type       EclaireurType
  profession String?
  bio        String?
  photoUrl   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  contents   MediaContent[] @relation("MediaToEclaireur")
}

model MediaContent {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?
  content     String // Markdown ou RichText
  mediaType   MediaType
  coverImage  String?
  audioUrl    String? // Pour les podcasts
  videoUrl    String? // Pour vidéos ou podcasts filmés
  transcript  String? // Transcription
  duration    Int? // Durée en minutes (lecture ou écoute)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories MediaCategory[]  @relation("MediaToCategory")
  eclaireurs MediaEclaireur[] @relation("MediaToEclaireur")

  // Relations existantes IQRH / Partenaires
  dimensionIqrh  Dimension?
  linkedArticles MediaContent[] @relation("RelatedArticles")
  relatedTo      MediaContent[] @relation("RelatedArticles")

  @@index([slug])
  @@index([mediaType])
  @@index([published])
}
