{
  "expo": {
    "name": "Link Office",
    "slug": "link-office-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "linkoffice",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkoffice.mobile"
    },
    "android": {
      "package": "com.linkoffice.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E8"
      }
    },
    "extra": {
      "apiUrl": "",
      "router": {},
      "eas": {
